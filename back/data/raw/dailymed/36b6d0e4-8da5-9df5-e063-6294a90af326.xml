               <component>
                  <section ID="id_link_3151e0e8-a72f-f6d5-e063-6294a90a118e">
                     <id root="36b5a72c-1b61-c05a-e063-6294a90a4eac"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Keep out of reach of children. </content>
                        </paragraph>
                        <paragraph>In case of overdose, get medical help or contact a Poison Control Center right away toll-free number 1-800-222-1222.</paragraph>
                     </text>
                     <effectiveTime value="20250508"/>
                  </section>
