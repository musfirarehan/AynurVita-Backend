               <title>Package label</title>
               <text>
                  <renderMultiMedia referencedObject="MM1">
                     <caption>WELLNESS BASICS Ibuprofen Tablets</caption>
                  </renderMultiMedia>
               </text>
               <effectiveTime value="20260805"/>
               <component>
