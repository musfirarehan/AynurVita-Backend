         <component>
            <section ID="L99bbff38-a9cd-416d-bd83-175ee3bcd317">
               <id root="584b4cbc-0406-400e-e063-6294a90abd99"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions:</title>
               <text>
                  <paragraph>• Change wet and soiled diapers promptly 
  <br/>  • Cleanse the diaper area, and allow to dry • Apply as needed
 </paragraph>
               </text>
               <effectiveTime value="20260804"/>
            </section>
         </component>
         <component>
            <section ID="Lb1c4eda6-8769-4962-a7b7-5fd48cf8969e">
               <id root="584b4cbc-0407-400e-e063-6294a90abd99"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>Other Information</title>
               <text>
                  <paragraph>• Store at controlled room temperature 15°–30°C (59°–86°F) 
  <br/>  • Avoid excessive heat and humidity • Tamper Evident 
  <br/>  • Do not use if packet is torn, cut, or opened
 </paragraph>
               </text>
               <effectiveTime value="20260804"/>
            </section>
         </component>
