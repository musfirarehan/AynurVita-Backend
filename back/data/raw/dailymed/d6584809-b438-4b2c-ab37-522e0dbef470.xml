               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active Ingredient (in each gram)</title>
               <text>
                  <paragraph>White Petrolatum, USP, 93% w/w</paragraph>
               </text>
               <effectiveTime value="20260804"/>
               <component>
                  <section ID="Ld7c4b417-e360-4087-a428-0bbb57367934">
                     <id root="584b4cbc-03ff-400e-e063-6294a90abd99"/>
                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <title>Purpose</title>
                     <text>
                        <paragraph>Skin Protectant</paragraph>
                     </text>
                     <effectiveTime value="20260804"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="Lf3fcc868-25ee-44d8-923b-b56dd2e40e50">
               <id root="584b4cbc-0400-400e-e063-6294a90abd99"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses:</title>
               <text>
                  <paragraph>• Helps treat and prevent diaper rash 
  <br/>  • Temporarily protects minor: •Cuts •Scrapes •﻿Burns 
  <br/>  • Temporarily helps protect and helps relieve chapped and cracked skin or lips 
  <br/>  • Helps prevent and protect from the drying effects of wind and cold weather 
  <br/>  • Helps prevent and protect from chafed skin or minor skin irritations associated with diaper rash
 </paragraph>
               </text>
               <effectiveTime value="20260804"/>
            </section>
         </component>
         <component>
            <section ID="Le51c60bd-12f7-42ae-8b77-ae24a6400930">
               <id root="584b4cbc-0401-400e-e063-6294a90abd99"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings:</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only</content>
                  </paragraph>
               </text>
               <effectiveTime value="20260804"/>
               <component>
                  <section ID="L3b573be6-8e4e-46a9-8904-da669d3a8a3f">
                     <id root="584b4cbc-0402-400e-e063-6294a90abd99"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <title>Do not use on</title>
                     <text>
                        <paragraph>• Deep or puncture wounds • Animal bites • Serious burns</paragraph>
                     </text>
                     <effectiveTime value="20260804"/>
                  </section>
               </component>
               <component>
                  <section ID="Lc73f1020-f4ab-45a2-9b23-0a66e29c73f7">
                     <id root="584b4cbc-0403-400e-e063-6294a90abd99"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>When using this product</title>
                     <text>
                        <paragraph>• Do not get into eyes</paragraph>
                     </text>
                     <effectiveTime value="20260804"/>
                  </section>
               </component>
               <component>
                  <section ID="L5de3fc80-3874-4b71-b741-a324712b8ac5">
                     <id root="584b4cbc-0404-400e-e063-6294a90abd99"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>Stop use and ask a doctor if</title>
                     <text>
                        <list listType="unordered">
                           <item>The condition persists or gets worse</item>
                           <item>Symptoms last more than 7 days or clear up and occur again in a few days.</item>
                        </list>
                     </text>
                     <effectiveTime value="20260804"/>
                  </section>
               </component>
               <component>
                  <section ID="Lc93413f1-a1ad-410d-9e36-e235b8937064">
                     <id root="584b4cbc-0405-400e-e063-6294a90abd99"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>Keep out of reach of children.</title>
                     <text>
                        <paragraph>If swallowed, get medical help or contact a Poison Control Center right away</paragraph>
                     </text>
                     <effectiveTime value="20260804"/>
                  </section>
               </component>
            </section>
