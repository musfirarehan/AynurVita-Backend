               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item> store between 77-86°F (25-30°C) </item>
                  </list>
               </text>
               <effectiveTime value="20230407"/>
            </section>
         </component>
